			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array><string>wmv</string></array>
				<key>public.mime-type</key>
				<array><string>video/x-ms-wmv</string></array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.sina0.videoconverter.mxf</string>
