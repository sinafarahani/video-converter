<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>${PRODUCT_NAME}</string>
	<key>CFBundleExecutable</key>
	<string>${EXECUTABLE_NAME}</string>
	<key>CFBundleIdentifier</key>
	<string>${PRODUCT_BUNDLE_IDENTIFIER}</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>${PRODUCT_NAME}</string>
	<key>CFBundleIconFile</key>
	<string>converter.icns</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleShortVersionString</key>
	<string>${CONVERTER_VERSION}</string>
	<key>CFBundleVersion</key>
	<string>${CONVERTER_VERSION}</string>
	<key>LSMinimumSystemVersion</key>
	<string>${CEF_TARGET_SDK}</string>
	<key>LSFileQuarantineEnabled</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- The app writes only to the folders the user picks, but macOS still
	     requires a usage description before it will grant access to the
	     Desktop, Documents or Downloads folders. -->
	<key>NSDesktopFolderUsageDescription</key>
	<string>To read and write the video files you select.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>To read and write the video files you select.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>To read and write the video files you select.</string>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>To read and write video files on external drives you select.</string>
	<!-- Chromium requires this on modern macOS. -->
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<!-- "Open With" for audio and video files, and for folders.

	     Viewer at rank Alternate: listed in Finder's Open With menu, but never
	     chosen over an app that claims the type as its Owner or Default.
	     public.movie and public.audio cover every type macOS itself declares
	     (mp4, mov, avi, 3gp, mp3, m4a, wav, aiff, au), and also another app's
	     own UTI for, say, .mkv, since that conforms to the same parents. The
	     com.sina0.videoconverter types imported below cover the rest. The
	     parents also match a few types the engine does not convert (.mpg,
	     .m4v, .mid); the app leaves those alone and says so.

	     Folders get rank None: one dropped on the Dock icon is accepted, but
	     Finder never opens a folder with this app. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Audio or video file</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.movie</string>
				<string>public.audio</string>
				<string>com.sina0.videoconverter.mkv</string>
				<string>com.sina0.videoconverter.flv</string>
				<string>com.sina0.videoconverter.wmv</string>
				<string>com.sina0.videoconverter.mxf</string>
				<string>com.sina0.videoconverter.gxf</string>
				<string>com.sina0.videoconverter.lxf</string>
				<string>com.sina0.videoconverter.webm</string>
				<string>com.sina0.videoconverter.ts</string>
				<string>com.sina0.videoconverter.m2ts</string>
				<string>com.sina0.videoconverter.ogv</string>
				<string>com.sina0.videoconverter.aac</string>
				<string>com.sina0.videoconverter.flac</string>
				<string>com.sina0.videoconverter.ogg</string>
				<string>com.sina0.videoconverter.opus</string>
				<string>com.sina0.videoconverter.wma</string>
				<string>com.sina0.videoconverter.amr</string>
				<string>com.sina0.videoconverter.ape</string>
				<string>com.sina0.videoconverter.mpc</string>
				<string>com.sina0.videoconverter.oma</string>
				<string>com.sina0.videoconverter.aa3</string>
				<string>com.sina0.videoconverter.wv</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Folder</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>None</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.folder</string>
			</array>
		</dict>
	</array>
	<!-- Extensions the engine accepts that macOS declares no type for
	     (cmake/CheckMediaExtensions.cmake checks this list against
	     engine/src/util.cpp). Imported, not exported: where macOS or another
	     app declares the same extension, that declaration wins, and it
	     conforms to public.movie or public.audio anyway. .pcm is left out
	     (raw PCM cannot be probed), and gxf, lxf, oma and aa3 have no MIME
	     type to tag. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.sina0.videoconverter.mkv</string>
			<key>UTTypeDescription</key>
			<string>Matroska video</string>
			<key>UTTypeConformsTo</key>
			<array><string>public.movie</string></array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array><string>mkv</string></array>
				<key>public.mime-type</key>
				<array><string>video/x-matroska</string></array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.sina0.videoconverter.flv</string>
			<key>UTTypeDescription</key>
			<string>Flash video</string>
			<key>UTTypeConformsTo</key>
			<array><string>public.movie</string></array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array><string>flv</string></array>
				<key>public.mime-type</key>
				<array><string>video/x-flv</string></array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.sina0.videoconverter.wmv</string>
			<key>UTTypeDescription</key>
			<string>Windows Media video</string>
